# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
# NO REAL SECRET BELONGS IN THIS FILE. Every value here is either a local
# development default or a placeholder you are expected to replace. Anything
# that would be a genuine credential is left empty on purpose.
#
# Generate a strong value for any of the secrets below with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Set to `development` to allow throwaway defaults for the signing keys below.
# Leave it unset (or set anything else) and the services refuse to start
# without real keys, which is the behaviour you want everywhere but a laptop.
AURABEE_ENV=development

# ---- Postgres / TimescaleDB ----
# Local compose credentials. Change them for any deployment reachable off-host.
POSTGRES_USER=aurabee
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=aurabee
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://aurabee:change-me-local-only@localhost:5433/aurabee

# ---- MQTT ----
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_TELEMETRY=aurabee/telemetry/+
MQTT_CLIENT_ID=aurabee-ingest

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Object store (MinIO, S3-compatible) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=aurabee
S3_SECRET_KEY=change-me-local-only
S3_BUCKET=aurabee-media

# ---- Chain ----
CHAIN_RPC_URL=http://localhost:8545
CHAIN_ID=31337
CHAIN_NETWORK=localhost

# Signing keys for the relayer and the yield oracle. LEFT EMPTY DELIBERATELY.
#
# For local development, run `npx hardhat node` and paste in two of the private
# keys it prints on startup. Those accounts are well-known, funded only on your
# local chain, and worthless anywhere else -- which is exactly why they are not
# checked in here.
#
# For anything else, use keys from a signer you control and never put them in a
# file inside the repository. Prefer a KMS, a hardware signer, or your platform's
# secret manager.
RELAYER_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=

# ---- Device auth ----
# HMAC key the simulator and firmware sign telemetry frames with. Telemetry is
# what bounds minting, so a forged frame is a forged ceiling. Required unless
# AURABEE_ENV=development.
DEVICE_HMAC_KEY=
TELEMETRY_REPLAY_WINDOW_S=300

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000

# Session signing. Required in any deployment.
JWT_SECRET=

# Server-side pepper for jar seal secrets. This is the single value standing
# between a stolen database dump and forged verification for every jar in
# circulation. Required unless AURABEE_ENV=development.
SEAL_HMAC_KEY=

# ---- Web ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_VERIFY_BASE=http://localhost:3001/verify

# ---- Danger ----
# Lets the simulator write frames with simulated timestamps. MUST be false or
# unset in any real deployment: with it on, replay protection is meaningless.
ALLOW_TIME_TRAVEL=false
